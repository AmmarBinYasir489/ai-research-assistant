SEARCH_PROVIDER=google_news
SEARCH_RESULT_COUNT=15
FINAL_SOURCE_COUNT=5
MAX_ARTICLE_AGE_DAYS=30
MAX_RESEARCH_ATTEMPTS=2

# Optional override for a single CLI run: --ollama-model MODEL
SEARXNG_INSTANCES=https://search.inetol.net,https://searx.tiekoetter.com,https://opnxng.com,https://northboot.xyz

# LLM providers in fallback order: ollama | gemini | openai
LLM_PROVIDERS=ollama,gemini
LLM_MODEL=qwen2.5-coder:latest

# Ollama (local, optional OLLAMA_HOST for WSL/remote hosts)
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_HOST=localhost:11434

# Gemini (free tier key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI or any OpenAI-compatible endpoint (Groq, OpenRouter, etc.)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

SERPAPI_API_KEY=your_serpapi_key_here
